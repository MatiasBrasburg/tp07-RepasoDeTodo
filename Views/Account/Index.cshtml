@{
    ViewData["Title"] = "Index";
}
<section class="login-box">
    <h1>Login</h1>
    
    <form method="post" action='@Url.Action("LogIn2", "Account")'>
        <p>
            <li>Usuario: 
                <textarea name="UserName" id="IdUserName" rows="1" cols="20"></textarea>
            </li>

            <li>Contraseña: 
                 <input type="password" name="Contraseña" id="IdContraseña">
            </li>
            <input type="submit" value="Enviar">
        </p>
    </form>
     <h2>@ViewBag.MensajeLogin</h2>

    <p>No tienes cuenta, 
        <a href='@Url.Action("Registrarse1", "Account")'>Registrate</a>
    </p>

   
</section>